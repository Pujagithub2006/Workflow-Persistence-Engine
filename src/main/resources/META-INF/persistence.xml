<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="workflow-pu" transaction-type="RESOURCE_LOCAL">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.workflow.persistence.domain.model.User</class>
        <class>com.workflow.persistence.domain.model.Workspace</class>
        <class>com.workflow.persistence.domain.model.Project</class>
        <class>com.workflow.persistence.domain.model.Workflow</class>
        <class>com.workflow.persistence.domain.model.State</class>
        <class>com.workflow.persistence.domain.model.Transition</class>
        <class>com.workflow.persistence.domain.model.Issue</class>
        <class>com.workflow.persistence.domain.model.Comment</class>
        <class>com.workflow.persistence.domain.model.AuditLog</class>

        <properties>
            <!-- JDBC connection -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/workflow_db"/>
            <property name="jakarta.persistence.jdbc.user" value="postgres"/>
            <property name="jakarta.persistence.jdbc.password" value="PujaSQL@2006"/>

            <!-- Hibernate as provider -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Hibernate for statistics -->
            <property name="hibernate.generate_statistics" value="true"/>

            <!-- Batch Fetching -->
            <property name="hibernate.default_batch_fetch_size" value="10"/>
        </properties>
    </persistence-unit>
</persistence>